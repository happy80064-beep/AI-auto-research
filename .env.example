DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
CACHE_TTL_MS=300000
LLM_MAX_CONCURRENCY=4
RATE_LIMIT_QPS=60
LLM_RATE_LIMIT_QPS=8
VITE_APP_URL=https://your-app-url.com

# ---- 钉钉机器人告警 ----
# 获取方式：钉钉群 → 群设置 → 智能群助手 → 添加机器人 → 自定义
# Webhook 地址形如 https://oapi.dingtalk.com/robot/send?access_token=xxxx
AGENT_GATEWAY_ALERT_ENABLED=true
AGENT_GATEWAY_DINGTALK_WEBHOOK_URL=
# 加签密钥（机器人安全设置选择"加签"时填入，留空则不签名）
AGENT_GATEWAY_DINGTALK_SECRET=
# @提醒的手机号，逗号分隔（需为群内成员）
AGENT_GATEWAY_DINGTALK_AT_MOBILES=
# 是否 @所有人（设为 true 时忽略 AT_MOBILES）
AGENT_GATEWAY_DINGTALK_IS_AT_ALL=false
# 最小告警状态码（仅 HTTP 状态码 >= 此值才告警，默认 500）
AGENT_GATEWAY_ALERT_MIN_STATUS_CODE=500
# 去重/限流窗口秒数（相同错误在此时间内仅通知一次，默认 60）
AGENT_GATEWAY_ALERT_RATE_LIMIT_SECONDS=60
# 关键词（机器人安全设置选择"关键词"时填入，消息中必须包含此词）
AGENT_GATEWAY_DINGTALK_KEYWORD=
# 服务名称（显示在告警消息中）
AGENT_GATEWAY_DINGTALK_SERVICE_NAME=AI-auto-research
# 环境标识（显示在告警消息中，如 production / staging）
AGENT_GATEWAY_DINGTALK_ENV=production
